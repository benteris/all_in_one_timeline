<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stat button on Project Form: Purely opens All In One Timeline within the project -->
    <record id="edit_project_inherit_all_in_one_timeline" model="ir.ui.view">
        <field name="name">project.project.form.inherit.all_in_one_timeline</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_all_in_one_timeline"
                        icon="fa-tasks">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">All In One</span>
                        <span class="o_stat_text">Timeline</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
