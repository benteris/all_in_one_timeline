<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Milestone Form View Inherit: Add Planned Date (daterange) before Deadline -->
    <record id="project_milestone_view_form_inherit_all_in_one_timeline" model="ir.ui.view">
        <field name="name">project.milestone.view.form.inherit.all_in_one_timeline</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deadline']" position="before">
                <field name="date_start" string="Planned Date" widget="daterange" options="{'end_date_field': 'planned_date_end', 'always_range': '1'}"/>
                <field name="planned_date_end" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Milestone List View Inherit: Add Planned Date columns -->
    <record id="project_milestone_view_tree_inherit_all_in_one_timeline" model="ir.ui.view">
        <field name="name">project.milestone.view.list.inherit.all_in_one_timeline</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deadline']" position="before">
                <field name="date_start" optional="show"/>
                <field name="planned_date_end" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
