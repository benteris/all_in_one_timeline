<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone Timeline View for Project Tasks -->
    <record id="project_task_timeline" model="ir.ui.view">
        <field name="name">project.task.timeline</field>
        <field name="model">project.task</field>
        <field name="type">timeline</field>
        <field name="arch" type="xml">
            <timeline
                date_start="planned_date_start"
                date_stop="planned_date_end"
                default_group_by="project_id"
                event_open_popup="true"
            />
        </field>
    </record>

    <!-- Enable Timeline in Project Task Window Actions -->
    <record id="project.action_view_task" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,calendar,timeline,pivot,graph,activity</field>
    </record>
    <record id="project.project_task_action_from_partner" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,timeline,pivot,graph,activity</field>
    </record>
    <record id="project.act_project_project_2_project_task_all" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,calendar,timeline,pivot,graph,activity</field>
    </record>
    <record id="project.action_view_all_task" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,timeline,pivot,graph,activity</field>
    </record>

    <!-- Form View: Planned Dates (Date Range Picker) & Live Timer Buttons -->
    <record id="view_task_form2_inherit_gannt_lt" model="ir.ui.view">
        <field name="name">project.task.form.inherit.gannt_lt</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Planned Dates Date-Range Picker before Deadline -->
            <xpath expr="//label[@for='date_deadline']" position="before">
                <field name="planned_date_start"
                       widget="daterange"
                       options="{'end_date_field': 'planned_date_end'}"
                       string="Planuojamos datos (Planned Dates)"/>
                <field name="planned_date_end" invisible="1"/>
                <field name="actual_finish_date" readonly="1" invisible="not actual_finish_date" string="Faktinė pabaiga"/>
            </xpath>

            <!-- Header buttons on top of Task / Subtask form -->
            <xpath expr="//header" position="inside">
                <field name="is_timer_running" invisible="1"/>
                <field name="timer_start" invisible="1"/>
                <field name="first_timer_start" invisible="1"/>
                <field name="timer_total_seconds" invisible="1"/>
                <field name="timer_display_seconds" invisible="1"/>
                <field name="effective_hours" invisible="1"/>
                <field name="active_user_id" invisible="1"/>
                <field name="is_paused" invisible="1"/>
                <field name="last_pause_reason" invisible="1"/>
                <field name="has_been_approved" invisible="1"/>
                <field name="approved_baseline_duration" invisible="1"/>
                <span class="badge text-bg-warning d-inline-flex align-items-center py-2 px-3 ms-2"
                      groups="GanntLT.group_gannt_lt_worker"
                      invisible="not is_timer_running or not active_user_id">
                    <i class="fa fa-play me-1"/> Vykdo: <field name="active_user_id" readonly="1" class="ms-1 fw-bold"/>
                </span>
                <span class="badge text-bg-secondary d-inline-flex align-items-center py-2 px-3 ms-2"
                      groups="GanntLT.group_gannt_lt_worker"
                      invisible="not is_paused">
                    <i class="fa fa-pause me-1 text-warning"/> Pristabdyta: <field name="last_pause_reason" readonly="1" class="ms-1"/>
                </span>
                <span class="badge text-bg-info d-inline-flex align-items-center py-2 px-3 ms-2 text-white"
                      groups="GanntLT.group_gannt_lt_worker"
                      invisible="not has_been_approved">
                    <i class="fa fa-anchor me-1"/> Užrakintas planas (<field name="approved_baseline_duration" readonly="1"/> val.)
                </span>
                <button name="action_timer_start"
                        type="object"
                        string="Pradėti"
                        class="btn-primary"
                        icon="fa-play"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="is_timer_running or state in ['03_approved', '1_done', '1_canceled']"/>
                <button name="action_timer_pause"
                        type="object"
                        string="Pristabdyti"
                        class="btn-secondary"
                        icon="fa-pause"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="not is_timer_running or state in ['03_approved', '1_done', '1_canceled']"/>
                <button name="action_timer_finish"
                        type="object"
                        string="Baigti"
                        class="btn-success"
                        icon="fa-check"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="state in ['03_approved', '1_done', '1_canceled']"/>
                <button name="action_timer_reopen"
                        type="object"
                        string="Atnaujinti"
                        class="btn-secondary"
                        icon="fa-undo"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="state not in ['03_approved', '1_done', '1_canceled']"/>
                <widget name="task_timer_widget" groups="GanntLT.group_gannt_lt_worker"/>
            </xpath>

            <!-- Ensure Sub-tasks tab is visible on all tasks and subtasks regardless of parent or depth -->
            <xpath expr="//page[@name='sub_tasks_page']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

            <!-- Show Allocated hours and Effective hours in subtasks list view -->
            <xpath expr="//page[@name='sub_tasks_page']//field[@name='child_ids']/list/field[@name='allocated_hours']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']//field[@name='child_ids']/list/field[@name='effective_hours']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']//field[@name='child_ids']/list/field[@name='stage_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- Action buttons & Live Timer in Sub-tasks tab list view rows -->
            <xpath expr="//page[@name='sub_tasks_page']//field[@name='child_ids']/list" position="inside">
                <field name="active_user_id" optional="show" widget="many2one_avatar_user" string="Vykdytojas" groups="GanntLT.group_gannt_lt_worker"/>
                <field name="is_paused" optional="hide" string="Pristabdyta" groups="GanntLT.group_gannt_lt_worker"/>
                <field name="has_been_approved" optional="hide" string="Patvirtintas planas" groups="GanntLT.group_gannt_lt_worker"/>
                <field name="is_timer_running" column_invisible="True"/>
                <field name="timer_start" column_invisible="True"/>
                <field name="first_timer_start" column_invisible="True"/>
                <field name="timer_total_seconds" column_invisible="True"/>
                <field name="timer_display_seconds" column_invisible="True"/>
                <field name="effective_hours" column_invisible="True"/>
                <button name="action_timer_start"
                        type="object"
                        title="Pradėti"
                        class="btn-success px-2"
                        icon="fa-play"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="is_timer_running or state in ['03_approved', '1_done', '1_canceled']"/>
                <button name="action_timer_pause"
                        type="object"
                        title="Pristabdyti"
                        class="btn-warning px-2"
                        icon="fa-pause"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="not is_timer_running or state in ['03_approved', '1_done', '1_canceled']"/>
                <button name="action_timer_finish"
                        type="object"
                        title="Baigti"
                        class="btn-success px-2"
                        icon="fa-check"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="state in ['03_approved', '1_done', '1_canceled']"/>
                <button name="action_timer_reopen"
                        type="object"
                        title="Atnaujinti"
                        class="btn-secondary px-2"
                        icon="fa-refresh"
                        groups="GanntLT.group_gannt_lt_worker"
                        invisible="state not in ['03_approved', '1_done']"/>
                <widget name="task_timer_widget" string="Laikmatis" groups="GanntLT.group_gannt_lt_worker"/>
            </xpath>
        </field>
    </record>

    <!-- Task List View: Add Planned Dates columns -->
    <record id="view_task_tree2_inherit_gannt_lt" model="ir.ui.view">
        <field name="name">project.task.list.inherit.gannt_lt</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="planned_date_start" optional="hide" string="Planuota pradžia"/>
                <field name="planned_date_end" optional="hide" string="Planuota pabaiga"/>
                <field name="actual_finish_date" optional="hide" string="Faktinė pabaiga"/>
            </field>
        </field>
    </record>
</odoo>
