<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gannt_lt.GanntLTView">
        <div class="o_timeline_view h-100 d-flex flex-column o_all_in_one_timeline_action o_gannt_lt_action" t-ref="root">
            <Layout display="display" className="'h-100 d-flex flex-column'">
                <t t-set-slot="control-panel-additional-actions">
                    <CogMenu t-if="env.searchModel"/>
                </t>
                <t t-set-slot="layout-actions">
                    <SearchBar t-if="env.searchModel and searchBarToggler and searchBarToggler.state.showSearchBar" toggler="searchBarToggler"/>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-if="env.searchModel and searchBarToggler" t-component="searchBarToggler.component" t-props="searchBarToggler.props"/>
                </t>

                <div class="all_in_one_timeline_container">
                    <!-- Top Toolbar -->
                    <div class="timeline_toolbar">
                        <div class="toolbar_left d-flex align-items-center gap-2">
                            <!-- Project Filter Dropdown -->
                            <select class="form-select form-select-sm project_select" t-model="state.selectedProjectId" t-on-change="onProjectChange">
                                <option value="0">Visi projektai</option>
                                <t t-foreach="state.projects" t-as="p" t-key="p.id">
                                    <option t-att-value="p.id" t-esc="p.name"/>
                                </t>
                            </select>
                            <span t-if="!state.canEdit" class="badge text-bg-secondary" title="Jūs turite tik peržiūros (Can View) teises">
                                <i class="fa fa-eye me-1"/>Tik peržiūra
                            </span>
                        </div>

                        <div class="toolbar_right">
                            <!-- Backdrop for Work Hours Popover -->
                            <div t-if="state.showWorkHoursDropdown" class="work_hours_backdrop" t-on-click="closeWorkHoursDropdown"/>

                            <!-- Quick Focus to Today & Hierarchy & Fit to Screen -->
                            <div class="btn-group btn-group-sm">
                                <div class="btn-group btn-group-sm position-relative" role="group">
                                    <button class="btn btn-secondary" type="button" t-on-click="toggleWorkHoursDropdown" title="Nustatyti darbo valandas ir pietų pertrauką">
                                        <i class="fa fa-clock-o me-1"/> Darbo valandos
                                    </button>

                                    <!-- Working Hours Dropdown Popover -->
                                    <div t-if="state.showWorkHoursDropdown" class="work_hours_popover shadow-lg border rounded p-3 bg-white" t-on-click="onPopoverClick">
                                        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                            <h6 class="mb-0 fw-bold text-dark">
                                                <i class="fa fa-clock-o text-primary me-2"/>Darbo valandų nustatymai
                                            </h6>
                                            <button type="button" class="btn-close" aria-label="Uždaryti" t-on-click="closeWorkHoursDropdown"/>
                                        </div>

                                        <div class="text-muted mb-2" style="font-size: 11px; line-height: 1.4;">
                                            Nurodykite kiekvienos savaitės dienos darbo laiką. Pietų pertrauka bus pažymėta kaip nedarbo laikas (blankiom raidėm).
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                                            <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="applyWorkHoursToWeekdays" title="Nukopijuoti Pirmadienio nustatymus į Antradienį–Penktadienį">
                                                <i class="fa fa-copy me-1"/>Taikyti I–V (kaip Pirmadienį)
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="resetDefaultWorkHours" title="Atstatyti standartinį grafiką (08:00–17:00, pietūs 12:45–13:45)">
                                                <i class="fa fa-history me-1"/>Standartinis (8:00–17:00)
                                            </button>
                                        </div>

                                        <div class="my-1" style="overflow-x: hidden;">
                                            <table class="table table-sm table-borderless align-middle mb-0 w-100" style="font-size: 12px;">
                                                <thead>
                                                    <tr class="text-muted border-bottom" style="font-size: 10px; text-transform: uppercase;">
                                                        <th style="width: 140px;">Diena</th>
                                                        <th style="width: 72px;" class="text-center">Pradžia</th>
                                                        <th style="width: 154px;" class="text-center">Pietų pertrauka</th>
                                                        <th style="width: 72px;" class="text-center">Pabaiga</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="workDaysList" t-as="day" t-key="day.dayIndex">
                                                        <tr t-att-class="day.active ? '' : 'text-muted bg-light opacity-75'">
                                                            <td>
                                                                <div class="form-check form-switch mb-0">
                                                                    <input class="form-check-input" type="checkbox" t-model="day.active" t-att-id="'work_day_switch_' + day.dayIndex"/>
                                                                    <label class="form-check-label fw-semibold ms-1" t-att-for="'work_day_switch_' + day.dayIndex" t-esc="day.name"/>
                                                                </div>
                                                            </td>
                                                            <t t-if="day.active">
                                                                <td>
                                                                    <input type="text"
                                                                           class="form-control form-control-sm text-center font-monospace px-1 work_time_input"
                                                                          
                                                                           maxlength="5"
                                                                           placeholder="08:00"
                                                                           t-model="day.start"
                                                                           t-on-blur="(ev) => this.onTimeInputBlur(day, 'start', ev)"/>
                                                                </td>
                                                                <td>
                                                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                                                        <input type="text"
                                                                               class="form-control form-control-sm text-center font-monospace px-1 work_time_input"
                                                                              
                                                                               maxlength="5"
                                                                               placeholder="12:45"
                                                                               t-model="day.lunchStart"
                                                                               t-on-blur="(ev) => this.onTimeInputBlur(day, 'lunchStart', ev)"/>
                                                                        <span class="text-muted">–</span>
                                                                        <input type="text"
                                                                               class="form-control form-control-sm text-center font-monospace px-1 work_time_input"
                                                                              
                                                                               maxlength="5"
                                                                               placeholder="13:45"
                                                                               t-model="day.lunchEnd"
                                                                               t-on-blur="(ev) => this.onTimeInputBlur(day, 'lunchEnd', ev)"/>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <input type="text"
                                                                           class="form-control form-control-sm text-center font-monospace px-1 work_time_input"
                                                                          
                                                                           maxlength="5"
                                                                           placeholder="17:00"
                                                                           t-model="day.end"
                                                                           t-on-blur="(ev) => this.onTimeInputBlur(day, 'end', ev)"/>
                                                                </td>
                                                            </t>
                                                            <t t-else="">
                                                                <td colspan="3" class="text-muted text-center fst-italic py-1" style="font-size: 11px;">
                                                                    Poilsio diena
                                                                </td>
                                                            </t>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="d-flex align-items-center justify-content-end gap-2 mt-3 pt-2 border-top">
                                            <button type="button" class="btn btn-sm btn-outline-secondary px-3" t-on-click="closeWorkHoursDropdown">
                                                Atšaukti
                                            </button>
                                            <button type="button" class="btn btn-sm btn-primary px-3" t-on-click="saveWorkHours">
                                                <i class="fa fa-check me-1"/>Išsaugoti
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <button class="btn btn-secondary" t-on-click="navigateToday" title="Grįžti į šiandien / Focus on Today">
                                    <i class="fa fa-calendar-check-o me-1"/> Šiandien
                                </button>
                                <button class="btn btn-secondary" t-att-disabled="!canUndo" t-on-click="undoAction" title="Atšaukti paskutinį veiksmą (Ctrl+Z) / Undo">
                                    <i class="fa fa-undo me-1"/> Atšaukti
                                </button>
                                <button class="btn btn-secondary" t-on-click="expandAll" title="Išskleisti viską">
                                    <i class="fa fa-expand me-1"/> Išskleisti
                                </button>
                                <button class="btn btn-secondary" t-on-click="collapseAll" title="Suskleisti viską">
                                    <i class="fa fa-compress me-1"/> Suskleisti
                                </button>
                                <button class="btn btn-secondary" t-on-click="resetView" title="Atstatyti į pradinį vaizdą (40%, suskleista, centruota į šiandien) / Reset View">
                                    <i class="fa fa-refresh me-1"/> Pradinis vaizdas
                                </button>
                            </div>

                            <!-- Single Unified Zoom Controls (Percentage Only, No Dropdown) -->
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-secondary" t-on-click="zoomOut" title="Mažinti / Zoom Out (-)">
                                    <i class="fa fa-search-minus"/>
                                </button>
                                <button class="btn btn-secondary px-2 fw-semibold" type="button" style="min-width: 52px;" t-on-click="resetView" title="Atstatyti pradinį 0% vaizdą">
                                    <span t-esc="state.zoomLevel + '%'"/>
                                </button>
                                <button class="btn btn-secondary" t-on-click="zoomIn" title="Didinti / Zoom In (+)">
                                    <i class="fa fa-search-plus"/>
                                </button>
                            </div>

                            <!-- Export Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fa fa-download me-1"/> Eksportuoti
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><a class="dropdown-item" href="#" t-on-click.prevent="exportToPDF"><i class="fa fa-file-pdf-o text-danger me-2"/>Eksportuoti į PDF</a></li>
                                    <li><a class="dropdown-item" href="#" t-on-click.prevent="exportToPNG"><i class="fa fa-file-image-o text-primary me-2"/>Eksportuoti į PNG</a></li>
                                    <li><a class="dropdown-item" href="#" t-on-click.prevent="exportToExcel"><i class="fa fa-file-excel-o text-success me-2"/>Eksportuoti į Excel</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Main Area -->
                    <div class="timeline_main_area">
                        <!-- Gantt Canvas Container -->
                        <div class="gantt_canvas_box" t-ref="ganttElement"/>
                    </div>
                </div>
            </Layout>
        </div>
    </t>
    <t t-name="all_in_one_timeline.AllInOneTimelineView">
        <t t-call="gannt_lt.GanntLTView"/>
    </t>
</templates>
