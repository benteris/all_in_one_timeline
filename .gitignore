# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Explicitly ensure static assets and vendor libraries are NEVER ignored by parent .gitignore rules
!static/
!static/**
!static/lib/
!static/lib/**
!static/src/
!static/src/**
!static/src/vendor/
!static/src/vendor/**
